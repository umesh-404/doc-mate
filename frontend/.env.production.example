# =============================================================================
# Doc-mate frontend — PRODUCTION environment (Vercel)
# =============================================================================
# On Vercel, set these in Project -> Settings -> Environment Variables
# (Environment: Production). Do NOT commit real values.
#
# NEXT_PUBLIC_ vars are inlined into the browser bundle at build time, so a
# change here requires a redeploy to take effect.
# -----------------------------------------------------------------------------

# Base URL of the deployed FastAPI backend (no trailing slash).
# Render example:  https://docmate-backend.onrender.com
# Fly example:     https://docmate-backend.fly.dev
NEXT_PUBLIC_API_URL=https://your-backend-host.example.com
