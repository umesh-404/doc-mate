# =============================================================================
# Doc-mate — PRODUCTION environment reference (names only, NO real secrets)
# =============================================================================
# Canonical list of every variable to set when deploying. Do NOT commit a
# filled-in copy. Set backend vars on the backend host (Render/Fly) and the
# frontend var on Vercel. See docs/DEPLOYMENT.md for the full runbook.
#
# Secrets you must provide: DATABASE_URL, JWT_SECRET, the four S3_* values,
# and (only if using a real LLM) <PROVIDER>_API_KEY.
# -----------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# App (backend)
# ---------------------------------------------------------------------------
APP_NAME=Doc-mate
ENVIRONMENT=production
# Number of Uvicorn workers (backend container). Tune to host plan CPU/RAM.
WEB_CONCURRENCY=2
# Comma-separated allowed origins. MUST include your Vercel domain, e.g.
#   https://doc-mate.vercel.app,https://doc-mate-git-main-you.vercel.app
CORS_ORIGINS=https://your-frontend.vercel.app

# ---------------------------------------------------------------------------
# Database (managed Postgres WITH pgvector — Neon / Supabase / Render).
# MUST use the SQLAlchemy + psycopg v3 driver prefix. pgvector is enabled by
# `alembic upgrade head` (migration runs CREATE EXTENSION vector).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# ---------------------------------------------------------------------------
# Auth (JWT). Generate a strong secret: `openssl rand -hex 32`.
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE-ME-generate-a-32-byte-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY=1440

# ---------------------------------------------------------------------------
# Object storage (S3-compatible: Cloudflare R2 or Supabase Storage).
# For Cloudflare R2, S3_ENDPOINT looks like:
#   https://<ACCOUNT_ID>.r2.cloudflarestorage.com   (S3_REGION=auto)
# ---------------------------------------------------------------------------
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=docmate
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# ---------------------------------------------------------------------------
# LLM layer. Leave LLM_PROVIDER empty to run in deterministic STUB mode with
# NO external key (recommended for the demo). To use a real provider, set the
# fields and export the matching <PROVIDER>_API_KEY as a secret.
# ---------------------------------------------------------------------------
LLM_PROVIDER=
LLM_MODEL_MULTIMODAL=
LLM_MODEL_REASONING=
EMBEDDING_MODEL=
EMBEDDING_DIM=1536
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Frontend (set on Vercel, NOT on the backend host).
# Base URL of the deployed backend, no trailing slash.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://your-backend-host.example.com
