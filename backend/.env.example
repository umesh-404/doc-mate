# Doc-mate backend environment. Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME=Doc-mate
ENVIRONMENT=local
# Comma-separated list of allowed CORS origins (frontend dev server).
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (SQLAlchemy 2.0 + psycopg v3 driver, Postgres + pgvector)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://docmate:docmate@localhost:5432/docmate

# ---------------------------------------------------------------------------
# Auth (JWT)
# ---------------------------------------------------------------------------
# CHANGE THIS in every non-local environment.
JWT_SECRET=dev-insecure-change-me-please-set-a-real-32b-secret
JWT_ALGORITHM=HS256
# Access token lifetime in minutes.
JWT_EXPIRY=1440

# ---------------------------------------------------------------------------
# Governance — consent enforcement on clinically sensitive reads
# (GET /patients/{id}, GET /documents/{id}, GET /patients/{id}/summary,
#  GET /patients/{id}/fhir, GET /patients/{id}/search)
#
#   audit_only  DEFAULT. Consent is evaluated and every denial is written to
#               the audit trail, but the read is never blocked. Keeps the demo
#               and scripts/e2e_smoke.py working end to end.
#   enforce     A denial returns 403. Callers who genuinely need the record
#               pass ?break_glass_reason=emergency_care — access is permitted
#               and audit-flagged break_glass=True for retrospective review.
#   off         Skip the check entirely (not recommended).
#
# Anything unrecognised falls back to audit_only — a typo must never silently
# disable the governance trail.
# ---------------------------------------------------------------------------
CONSENT_ENFORCEMENT=audit_only

# ---------------------------------------------------------------------------
# Object storage (S3-compatible; MinIO locally)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=docmate
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# LLM layer (LiteLLM-compatible). Placeholders only — providers are called
# exclusively from app/llm/. Feature code must never import provider SDKs.
#
# Leave LLM_PROVIDER empty (or set it to "stub") to run fully offline with
# deterministic synthetic extractions/summaries and local pseudo-embeddings —
# this is the DEFAULT and needs no API key. Stub mode also activates
# automatically whenever the provider's API key is absent from the environment.
#
# To use a real provider, set LLM_PROVIDER (e.g. openai | gemini | ollama),
# the model names below, and export the matching <PROVIDER>_API_KEY, e.g.
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=sk-...
# ---------------------------------------------------------------------------
LLM_PROVIDER=
LLM_MODEL_MULTIMODAL=
LLM_MODEL_REASONING=
EMBEDDING_MODEL=
EMBEDDING_DIM=1536
# Provider API key (name must be <PROVIDER>_API_KEY). Example for OpenAI:
# OPENAI_API_KEY=
